# ScriptForge Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scriptforge

# Encryption key for API keys at rest (generate with: openssl rand -base64 32)
SCRIPTFORGE_ENCRYPTION_KEY=change-me-to-a-random-64-char-string

# LLM API Keys (optional — can also be configured per-project via UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Storage path for project git repositories
PROJECTS_STORAGE_PATH=data/projects
